#!/usr/bin/env python3
"""Runs codex after trusting the hooks of the installed plugins of the chosen marketplaces in its CODEX_HOME.

Temporary: delete it once Codex or T3 trusts plugin hooks on their own. Codex skips a plugin hook, without a word,
while the hook is not trusted, and any change to the plugin (an update included) makes it untrusted again. Through
`codex app-server` this wrapper writes `trusted_hash = currentHash` to the user config for each enabled, unmanaged
hook that is not trusted, of a plugin of the marketplaces in CODEX_TRUSTED_MARKETPLACES (default:
kvokka-harness-plugins), then replaces itself with the real codex and the same arguments. A plugin or marketplace
that is not installed is none of its business.

When a hook is still not trusted after that, codex is not started: the wrapper says why on stderr and exits 1, so a
session never runs without those hooks unnoticed.
"""

import json
import os
import re
import shutil
import signal
import subprocess
import sys

TIMEOUT = 30


def marketplaces():
    return set(re.split(r"[\s,]+", os.environ.get("CODEX_TRUSTED_MARKETPLACES", "kvokka-harness-plugins").strip()))


def real_codex():
    """The codex this wrapper stands for: CODEX_TRUSTED_REAL, else the first `codex` on PATH that is not this file."""
    if os.environ.get("CODEX_TRUSTED_REAL"):
        return os.environ["CODEX_TRUSTED_REAL"]
    me = os.path.realpath(__file__)
    for d in os.environ.get("PATH", "").split(os.pathsep):
        path = shutil.which("codex", path=d or ".")
        if path and os.path.realpath(path) != me:
            return path
    raise SystemExit("codex-trusted: no codex on PATH but this wrapper; set CODEX_TRUSTED_REAL")


def edits(hooks, chosen):
    """The config edits that trust the hooks of the chosen marketplaces' plugins that are not trusted yet."""
    return [
        {
            "keyPath": "hooks.state.%s.trusted_hash" % json.dumps(h["key"]),
            "value": h["currentHash"],
            "mergeStrategy": "upsert",
        }
        for h in hooks
        if h.get("source") == "plugin"
        and str(h.get("pluginId", "")).rpartition("@")[2] in chosen
        and h.get("enabled") is True
        and h.get("isManaged") is False
        and h.get("trustStatus") != "trusted"
        and h.get("key")
        and h.get("currentHash")
    ]


def user_layer(config):
    for layer in config.get("layers") or []:
        name = layer.get("name") or {}
        if name.get("type") == "user" and name.get("profile") is None:
            return name["file"], layer["version"]
    raise RuntimeError("no user config layer in CODEX_HOME")


def trust(codex, chosen):
    """Trusts the hooks; returns how many it trusted, or raises with the hooks that are still not trusted."""
    proc = subprocess.Popen(
        [codex, "app-server", "--listen", "stdio://"],
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
    )
    ids = iter(range(1, 1000))

    def call(method, params):
        i = next(ids)
        proc.stdin.write(json.dumps({"id": i, "method": method, "params": params}) + "\n")
        proc.stdin.flush()
        for line in proc.stdout:
            msg = json.loads(line)
            if msg.get("id") == i:
                if "result" not in msg:
                    raise RuntimeError("%s: %s" % (method, msg.get("error")))
                return msg["result"]
        raise RuntimeError("codex app-server closed during %s" % method)

    def untrusted():
        return edits([h for group in call("hooks/list", {})["data"] for h in group.get("hooks", [])], chosen)

    try:
        call("initialize", {"clientInfo": {"name": "codex-trusted", "version": "0"},
                            "capabilities": {"experimentalApi": True}})
        # The version before the listing: a change of the config in between makes the write fail, not overwrite it.
        file, version = user_layer(call("config/read", {"includeLayers": True}))
        todo = untrusted()
        if not todo:
            return 0
        error = ""
        try:
            call("config/batchWrite", {"filePath": file, "expectedVersion": version,
                                       "reloadUserConfig": True, "edits": todo})
        except RuntimeError as e:  # another session may have trusted them meanwhile: the check decides
            error = "; %s" % e
        left = untrusted()
        if left:
            raise RuntimeError("not trusted: %s%s" % (", ".join(e["keyPath"].split('"')[1] for e in left), error))
        return len(todo)
    finally:
        proc.kill()
        proc.wait()


def main():
    codex = real_codex()

    def timeout(*_):
        raise TimeoutError("no answer from codex app-server in %d s" % TIMEOUT)

    signal.signal(signal.SIGALRM, timeout)
    signal.alarm(TIMEOUT)
    try:
        n = trust(codex, marketplaces())
    except Exception as e:  # noqa: BLE001 - whatever failed, the session must not start without its hooks
        print("codex-trusted: codex is not started, plugin hooks would not run: %s\n"
              "codex-trusted: fix the cause, or trust the hooks by hand: CODEX_HOME=%s %s, then /hooks"
              % (e, os.environ.get("CODEX_HOME", "~/.codex"), codex), file=sys.stderr)
        sys.exit(1)
    finally:
        signal.alarm(0)
    if n:
        print("codex-trusted: trusted %d plugin hook(s)" % n, file=sys.stderr)
    os.execvp(codex, [codex] + sys.argv[1:])


if __name__ == "__main__":
    main()

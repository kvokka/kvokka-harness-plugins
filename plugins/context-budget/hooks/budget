#!/bin/sh
# The hook of the context-budget plugin (README.md) for Claude and Codex, on every event it is attached to; the input
# is on stdin. The limits come from CONTEXT_BUDGET_SOFT, CONTEXT_BUDGET_HARD and CONTEXT_BUDGET_STEP.
set -eu
soft=${CONTEXT_BUDGET_SOFT:-300000} hard=${CONTEXT_BUDGET_HARD:-420000} step=${CONTEXT_BUDGET_STEP:-30000}
data=${CLAUDE_PLUGIN_DATA:?context-budget: CLAUDE_PLUGIN_DATA is not set; run the hook from the plugin}
mkdir -p "$data"
input=$(cat)
field() { printf '%s' "$input" | jq -r "$1 // empty"; }
event=$(field .hook_event_name)
session=$(field .session_id)
agent=$(field .agent_id)
# The files of this agent: the session's own, or a subagent's of it.
me="$data/$session${agent:+.agent-$agent}"
main=$(field .transcript_path)
# Codex names the turn in every input but that of `SessionStart`; Claude in none.
codex=$(field .turn_id)
cwd=$(field .cwd)
[ -z "$cwd" ] || cd "$cwd"

# The transcript of the agent the hook runs for: a subagent's is its own, beside the session's.
transcript() {
    if [ -z "$agent" ] || [ -n "$codex" ]; then
        printf '%s' "$main"
        return
    fi
    printf '%s' "$(dirname "$main")/$session/subagents/agent-$agent.jsonl"
}

# The tokens of the context: those of the last answer of the model, its input with the cache and its output.
tokens() {
    [ -f "$1" ] || {
        echo 0
        return
    }
    n=$(grep -E '"usage"|"compact_boundary"|"token_count"' "$1" | jq -R 'fromjson? |
        if .type == "system" and .subtype == "compact_boundary" then 0
        elif .type == "assistant" and .message.usage and .message.model != "<synthetic>" then
            .message.usage | [.input_tokens, .cache_creation_input_tokens, .cache_read_input_tokens, .output_tokens]
            | map(. // 0) | add
        elif .type == "event_msg" and .payload.type == "token_count" then
            .payload.info.last_token_usage.total_tokens // empty
        else empty end' | tail -n 1)
    echo "${n:-0}"
}

fenced() { printf '\n%s\n%s\n%s\n\n' '```' "$1" '```'; }

git_state() {
    echo "## git status --short"
    fenced "$(git status --short 2>&1 | head -n 80)"
    # The commits of the session: since the commit it started on, else the last ten.
    base=$(cat "$data/$session.base" 2>/dev/null || true)
    if [ -n "$base" ]; then set -- "$base..HEAD"; else set -- -n 10; fi
    echo "## git log $*"
    fenced "$(git log --oneline "$@" 2>&1 | head -n 30)"
    echo "## git diff --stat HEAD"
    fenced "$(git diff --stat HEAD 2>&1 | head -n 40)"
}

# The state of the work when the session is stopped, for whoever takes it up: git and the agent's last steps.
dump() {
    echo "# context-budget: the session was stopped"
    echo
    echo "The ${agent:+subagent $agent of the }session $session went past its context budget before it wrapped up."
    echo "Below is the state as it was then."
    echo
    if git rev-parse -q --verify HEAD >/dev/null 2>&1; then
        git_state
    else
        echo "Its directory $(pwd) is not a git checkout."
        echo
    fi
    echo "## The last tool calls"
    fenced "$(jq -R -r 'fromjson? |
        if .type == "assistant" and .message.model != "<synthetic>" then
            .message.content[]? | select(.type == "tool_use") | "\(.name): \(.input | tojson | .[0:240])"
        elif .type == "response_item" and (.payload.type | . == "function_call" or . == "custom_tool_call") then
            .payload | "\(.name): \(.arguments // (.input | tojson) | .[0:240])"
        else empty end' "$1" 2>/dev/null | tail -n 12)"
    echo "## The last texts of the agent"
    jq -R -c 'fromjson? |
        if .type == "assistant" and .message.model != "<synthetic>" then .message.content[]? | select(.type == "text")
        elif .type == "response_item" and .payload.type == "message" and .payload.role == "assistant" then
            .payload.content[]? | select(.type == "output_text")
        else empty end | .text | select(test("\\S")) | .[0:3000]' "$1" 2>/dev/null | tail -n 3 |
        jq -r '"", .'
}

# stopped <who> <files>: the reason of a stop, naming the dump of the agent that went past its budget.
stopped() { echo "the context budget of this $1 is spent; it is stopped, and the state of its work is in $2.md"; }
who=session
[ -z "$agent" ] || who=subagent
# Claude ends the turn on `continue: false`; Codex rejects that answer on `PreToolUse` and would run the call.
deny() {
    jq -nc --arg r "$1" --argjson end "${2:-false}" '(if $end then {continue: false, stopReason: $r} else {} end) +
        {hookSpecificOutput: {hookEventName: "PreToolUse", permissionDecision: "deny", permissionDecisionReason: $r}}'
    exit 0
}
ends=true
[ -z "$codex" ] || ends=false

# Past `hard`: the state goes to `<agent>.md` once, and the agent stops. A subagent's stop is its own.
cut_off() {
    if [ ! -f "$me.stop" ]; then
        dump "$1" >"$me.md"
        : >"$me.stop"
    fi
    if [ "$event" = PreToolUse ]; then deny "$(stopped "$who" "$me")" "$ends"; fi
    jq -nc --arg r "$(stopped "$who" "$me")" '{continue: false, stopReason: $r}'
    exit 0
}

context() {
    jq -nc --arg e "$event" --arg t "$1" '{hookSpecificOutput: {hookEventName: $e, additionalContext: $t}}'
}

k() { echo "$(($1 / 1000))k"; }

case $event in
SessionStart)
    if [ ! -f "$data/$session.base" ] && base=$(git rev-parse -q --verify HEAD 2>/dev/null); then
        echo "$base" >"$data/$session.base"
    fi
    context "Your context budget is $(k "$soft") tokens. Past it you get a note: then wrap up your work."
    ;;
SubagentStart)
    context "Your context budget is $(k "$soft") tokens. Past it you get a note: then wrap up and return your summary."
    ;;
PreCompact)
    # Past `hard` the session stops instead of compacting; below it the harness's settings decide (README.md).
    t=$(transcript)
    [ "$(tokens "$t")" -lt "$hard" ] || cut_off "$t"
    ;;
PreToolUse)
    [ ! -f "$data/$session.stop" ] || deny "$(stopped session "$data/$session")" "$ends"
    [ ! -f "$me.stop" ] || deny "$(stopped "$who" "$me")" "$ends"
    t=$(transcript)
    n=$(tokens "$t")
    [ "$n" -lt "$hard" ] || cut_off "$t"
    case $(field .tool_name) in
    Agent | Task | *spawn_agent)
        [ "$n" -lt "$soft" ] ||
            deny "Your context is $(k "$n") tokens, past your budget of $(k "$soft"): call no subagents, wrap up."
        ;;
    esac
    ;;
PostToolUse)
    t=$(transcript)
    n=$(tokens "$t")
    [ "$n" -lt "$hard" ] || cut_off "$t"
    [ "$n" -ge "$soft" ] || exit 0
    last=$(cat "$me.noted" 2>/dev/null || echo 0)
    [ "$last" -eq 0 ] || [ "$n" -ge $((last + step)) ] || exit 0
    echo "$n" >"$me.noted"
    wrap="Your context is $(k "$n") tokens, past your budget of $(k "$soft"). Wrap up now: finish or roll back the"
    wrap="$wrap step at hand, start nothing new and call no subagents"
    summary="what is done, what did not work and why, what is started and not finished"
    summary="$summary (files, where it stopped, the next step)"
    if [ -n "$agent" ]; then
        context "$wrap; then return your summary to your caller: $summary."
    else
        context "$wrap; commit what is done; then give your summary as your final answer: $summary."
    fi
    ;;
esac

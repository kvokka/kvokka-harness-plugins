#!/bin/sh
# PreToolUse hook (Bash) of Claude and Codex: the hook input goes to dcg, which answers in the protocol of the harness.
# Without dcg no command runs: exit 2 with a reason on stderr blocks the call on both harnesses.
set -eu
if ! command -v dcg >/dev/null 2>&1; then
  echo "dcg plugin: \`dcg\` (destructive_command_guard) is not on the PATH of this session, so no shell command runs;" \
    "install it on the host or put it on the agent's PATH" >&2
  exit 2
fi
exec dcg

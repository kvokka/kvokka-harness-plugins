#!/bin/sh
# SessionStart hook of Claude and Codex: the hint of prompt.md joins the agent's context.
set -eu
command -v jq >/dev/null 2>&1 || { echo "conventional-commits: jq is not on the PATH; install it: mise use -g jq" >&2; exit 1; }
event=$(jq -r .hook_event_name)
jq -Rsc --arg e "$event" '{hookSpecificOutput: {hookEventName: $e, additionalContext: .}}' "$(dirname "$0")/../prompt.md"

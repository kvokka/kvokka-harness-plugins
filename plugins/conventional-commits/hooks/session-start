#!/bin/sh
# SessionStart hook of Claude and Codex. The session's Git includes a gitconfig at a stable path (README.md); this
# hook points it at the commit-msg check of the plugin as installed now, then gives the agent the hint of prompt.md.
set -eu
root=$(cd "$(dirname "$0")/.." && pwd)
dir=$HOME/.local/state/kvokka-harness-plugins/conventional-commits
mkdir -p "$dir"
tmp=$(mktemp "$dir/gitconfig.XXXXXX")
printf '[hook "kvokka-conventional-commits"]\n\tevent = commit-msg\n\tcommand = %s\n' "'$root/bin/commit-msg'" >"$tmp"
mv -f "$tmp" "$dir/gitconfig"
event=$(jq -r .hook_event_name)
jq -Rsc --arg e "$event" '{hookSpecificOutput: {hookEventName: $e, additionalContext: .}}' "$root/prompt.md"

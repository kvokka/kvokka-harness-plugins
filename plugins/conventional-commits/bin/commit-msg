#!/bin/sh
# Git commit-msg hook: the subject (first line of the message file $1) must be a Conventional Commit. The subjects
# Git writes itself for a merge or a revert pass, as commitlint lets them.
set -eu
if ! head -n 1 "$1" | grep -Eq '^([a-z][a-z0-9-]*(\([^()[:space:]]+\))?!?: [^[:space:]].*|Merge .*|Revert ".*)$'; then
  echo "Use a Conventional Commit subject such as 'fix(parser): handle empty input'." >&2
  exit 1
fi

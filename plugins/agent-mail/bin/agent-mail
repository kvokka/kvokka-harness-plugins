#!/bin/sh
# The hooks and the MCP server of the agent-mail plugin (README.md):
#   agent-mail session-start   SessionStart: start the server, register the session, give the agent its mail identity
#   agent-mail session-end     SessionEnd: release the session's reservations
#   agent-mail mcp             the MCP server `agent-mail` (.mcp.json): start the server, then relay stdio to it
#   agent-mail pre-commit      the pre-commit hook `agent-mail-reservations` (.pre-commit-hooks.yaml of the
#                              repository root): refuse a commit of paths another agent holds
set -eu
host=${AGENT_MAIL_HOST:-127.0.0.1} port=${AGENT_MAIL_PORT:-8765} ttl=${AGENT_MAIL_TTL:-3600}
[ "$host" != 0.0.0.0 ] || host=127.0.0.1
state=$HOME/.local/state/kvokka-harness-plugins/agent-mail
root=$(cd "$(dirname "$0")/.." && pwd)

die() {
  echo "agent-mail: $*" >&2
  exit 1
}

need_jq() { command -v jq >/dev/null 2>&1 || die "jq is not on the PATH; install it: mise use -g jq"; }

# `post <JSON-RPC message>`: the server's answer, empty for a notification; an HTTP error fails. The token, if any,
# goes on stdin.
post() {
  printf '%s' "${AGENT_MAIL_TOKEN:+Authorization: Bearer $AGENT_MAIL_TOKEN}" |
    curl -sS --fail-with-body --max-time "${max_time:-30}" -H @- -H 'Content-Type: application/json' \
      -H 'Accept: application/json, text/event-stream' --data-binary "$1" "http://$host:$port/mcp/"
}

# `call <tool> <arguments>`: the tool's result on stdout; a failure on stderr.
call() {
  request=$(printf '%s' "$2" | jq -c --arg t "$1" '{jsonrpc: "2.0", id: 1, method: "tools/call",
    params: {name: $t, arguments: .}}') || return 1
  answer=$(post "$request") || return 1
  printf '%s' "$answer" | jq -c --arg t "$1" '
    if .error.code == -32601 then "tool `\($t)` is not available: the tool filter of the server hides it\n" | halt_error
    elif .error then "tool `\($t)`: \(.error.message)\n" | halt_error
    elif .result.isError then "tool `\($t)`: \(.result.content[0].text | (fromjson? | .error.message) // .)\n"
      | halt_error
    else .result.content[0].text | fromjson end'
}

# The project key: the canonical common Git directory, shared by all worktrees of a repository; outside Git the
# directory itself.
key() {
  dir=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || dir=.
  (cd "$dir" && pwd -P)
}

# The file that keeps the mail name of the harness session <id>.
binding() { printf '%s/agents/%s.json' "$state" "$(printf '%s' "$1" | tr -c '[:alnum:]._-' '-')"; }

# Writes stdin to a file in one step, so a reader never sees half of it.
put() {
  tmp=$(mktemp "$1.XXXXXX")
  cat >"$tmp"
  mv -f "$tmp" "$1"
}

session_start() {
  need_jq
  input=$(cat)
  cwd=$(printf '%s' "$input" | jq -r '.cwd // empty')
  [ -z "$cwd" ] || cd "$cwd"
  id=$(printf '%s' "$input" | jq -r '.session_id // empty')
  [ -n "$id" ] || die "the hook input names no session"
  mkdir -p "$state/agents"
  file=$(binding "$id")
  key=$(key)
  thread=$(basename "${key%/.git}" | tr -c '[:alnum:]._\n-' '-')
  # A session of a thread seen before keeps its name in the same project.
  name=$(jq -r --arg key "$key" 'select(.key == $key) | .name' "$file" 2>/dev/null || true)
  program=codex
  [ -z "${CLAUDECODE:-}" ] || program=claude-code
  args=$(printf '%s' "$input" | jq -c --arg key "$key" --arg id "$id" --arg name "$name" --arg program "$program" '
    {human_key: $key, program: $program, model: ((.model | strings) // "unknown"), task_description: $id, inbox_limit: 5}
    + if $name != "" then {agent_name: $name} else {} end')
  # A step that fails prints nothing on stdout, one that works nothing on stderr. The binding is written either way:
  # the commit check refuses the commits of a session that has one with no name, since its registration failed.
  if up=$("$root/bin/agent-mail-up" 2>&1) && started=$(call macro_start_session "$args" 2>&1); then
    name=$(printf '%s' "$started" | jq -r .agent.name)
  else
    name=
  fi
  jq -nc --arg name "$name" --arg key "$key" --arg thread "$thread" '{name: $name, key: $key, thread: $thread}' |
    put "$file"
  if [ -n "$name" ]; then
    text=$(printf '%s' "$started" | jq -r --arg key "$key" --arg thread "$thread" --arg ttl "$ttl" '
      "Agent Mail (MCP server `agent-mail`): you are `\(.agent.name)` in the project `\($key)`; use `\($key)` as "
      + "`project_key`, `\(.agent.name)` as `agent_name` and `sender_name`, `\($thread)` as `thread_id`, and "
      + "`ttl_seconds: \($ttl)` for reservations, with paths relative to the repository root.\n"
      + if (.inbox | length) == 0 then "Your inbox is empty."
        else "Your inbox:\n" + (.inbox | map("- #\(.id) from \(.from): \(.subject) (thread \(.thread_id // "none"))")
          | join("\n")) end')
    text="$text

$(cat "$root/prompt.md")"
  else
    text="Agent Mail is unavailable (${started:-$up}): you have no mail name, and the repository's reservation check, if it has one, refuses your commits."
  fi
  jq -nc --arg t "$text" '{hookSpecificOutput: {hookEventName: "SessionStart", additionalContext: $t}}'
}

# The harness starts its MCP servers before the SessionStart hook runs, so the MCP entry starts the server itself,
# then relays each JSON-RPC message of stdin to it and its answer to stdout.
mcp() {
  need_jq
  "$root/bin/agent-mail-up" || exit 1
  max_time=120
  while IFS= read -r line; do
    if answer=$(post "$line"); then
      [ -z "$answer" ] || printf '%s\n' "$answer"
    else
      printf '%s' "$line" | jq -c 'select(.id != null) | {jsonrpc: "2.0", id,
        error: {code: -32000, message: "agent-mail: the Agent Mail server refused or did not answer"}}' || :
    fi
  done
}

session_end() {
  # Codex gives a SessionEnd hook 1 s by default, and both harnesses cap it at a few seconds.
  max_time=1
  need_jq
  id=$(jq -r '.session_id // empty')
  file=$(binding "$id")
  [ -f "$file" ] || exit 0
  call release_file_reservations "$(jq -c '{project_key: .key, agent_name: .name}' "$file")" >/dev/null
}

pre_commit() {
  # A commit outside an agent's session is not checked.
  [ -n "${CLAUDE_CODE_SESSION_ID:-}${CODEX_THREAD_ID:-}" ] || exit 0
  need_jq
  # Both sides of a rename: each is a path of the commit.
  paths=$(git diff --cached --name-only --no-renames -z | jq -Rsc 'split("\u0000") | map(select(length > 0))')
  [ "$paths" != "[]" ] || exit 0
  key=$(key)
  # The names of the harness sessions the commit runs in, in this project: both harnesses export the id of their
  # session, and a session started inside another one inherits the outer id, so all of them are this agent.
  bound=false names='[]'
  for id in "${CLAUDE_CODE_SESSION_ID:-}" "${CODEX_THREAD_ID:-}"; do
    file=$(binding "$id")
    [ -n "$id" ] && [ -f "$file" ] || continue
    bound=true
    names=$(jq -c --arg key "$key" --argjson names "$names" 'if .key == $key then $names + [.name] else $names end' "$file")
  done
  if [ "$names" = '[]' ]; then
    # A repository the session did not register in is not coordinated by it.
    [ "$bound" = true ] ||
      echo "agent-mail: this session is not coordinated (no agent-mail plugin); reservations not checked" >&2
    exit 0
  fi
  printf '%s' "$names" | jq -e 'all(. != "")' >/dev/null ||
    die "the commit is refused: this session has no Agent Mail name to check its reservations; see its session start"
  args=$(jq -nc --arg key "$key" --argjson names "$names" --argjson paths "$paths" \
    '{project_key: $key, agent_name: $names[0], paths: $paths}')
  result=$(call check_file_reservation_conflicts "$args") ||
    die "the commit is refused: its reservations could not be checked"
  held=$(printf '%s' "$result" | jq -r --argjson me "$names" '.conflicts[]? | .path as $p | .holders[]?
    | select(.exclusive and (.agent | IN($me[]) | not))
    | "  \($p): reserved by \(.agent) (\(.path_pattern), until \(.expires_ts))"')
  if [ -n "$held" ]; then
    printf 'agent-mail: the commit is refused: other agents hold these paths:\n%s\n' "$held" >&2
    exit 1
  fi
  [ "$(printf '%s' "$result" | jq .output_truncated)" != true ] ||
    die "the commit is refused: the check of its reservations was cut short"
}

case ${1:-} in
session-start) session_start ;;
session-end) session_end ;;
mcp) mcp ;;
pre-commit) pre_commit ;;
*) die "usage: agent-mail session-start | session-end | mcp | pre-commit" ;;
esac

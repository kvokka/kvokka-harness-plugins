{
  "mcpServers": {
    "agent-mail": {
      "command": "sh",
      "args": ["-c", "test -z \"$CLAUDE_PLUGIN_ROOT\" || cd \"$CLAUDE_PLUGIN_ROOT\"; exec ./bin/agent-mail mcp"],
      "cwd": ".",
      "env_vars": ["AGENT_MAIL_HOST", "AGENT_MAIL_PORT", "AGENT_MAIL_TOKEN", "AGENT_MAIL_TTL", "XDG_CONFIG_HOME",
        "HTTP_ALLOW_LOCALHOST_UNAUTHENTICATED"]
    }
  }
}

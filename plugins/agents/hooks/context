#!/bin/sh
# SessionStart hook of Claude and Codex: prompt.md joins the agent's context, with the cheaper models of the session's
# harness (AGENTS_CHEAP_MODELS) in it.
set -eu
command -v jq >/dev/null 2>&1 || { echo "agents: jq is not on the PATH; install it: mise use -g jq" >&2; exit 1; }
event=$(jq -r .hook_event_name)
jq -Rsc --arg e "$event" --arg models "${AGENTS_CHEAP_MODELS:-sonnet, haiku}" \
  '{hookSpecificOutput: {hookEventName: $e, additionalContext: gsub("\\{models\\}"; $models)}}' \
  "$(dirname "$0")/../prompt.md"
